<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_shortcuts_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp"
    android:background="@drawable/widget_bg_dark">

    <LinearLayout
        android:id="@+id/widget_shortcuts_card"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:padding="12dp" android:background="@drawable/widget_card_dark">

        <FrameLayout android:id="@+id/widget_accent_bar"
            android:layout_width="5dp" android:layout_height="42dp"
            android:layout_marginEnd="12dp" android:background="#8AB4F8" />

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/widget_title"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/app_name" android:textColor="#E8EAED"
                android:textSize="17sp" android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_title_seg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitStart"
                android:visibility="gone" />

            <TextView android:id="@+id/widget_subtitle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/widget_quick_actions"
                android:textColor="#9AA0A6" android:textSize="11sp"
                android:layout_marginTop="2dp" />

            <ImageView
                android:id="@+id/widget_subtitle_seg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitStart"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="8dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal">
        <TextView android:id="@+id/widget_open_dialer"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:text="@string/widget_open" android:textSize="13sp"
            android:textStyle="bold" android:textColor="#E8EAED"
            android:padding="10dp" android:layout_marginEnd="4dp"
            android:background="@drawable/widget_chip_dark" />

        <ImageView
            android:id="@+id/widget_open_dialer_seg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="10dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_chip_dark"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="centerInside"
            android:visibility="gone" />

        <TextView android:id="@+id/widget_contacts"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:text="@string/tab_contacts" android:textSize="13sp"
            android:textStyle="bold" android:textColor="#E8EAED"
            android:padding="10dp" android:layout_marginStart="4dp"
            android:background="@drawable/widget_chip_dark" />

        <ImageView
            android:id="@+id/widget_contacts_seg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="10dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_chip_dark"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="centerInside"
            android:visibility="gone" />

    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="8dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal">
        <TextView android:id="@+id/widget_recents"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:text="@string/tab_recents" android:textSize="13sp"
            android:textStyle="bold" android:textColor="#E8EAED"
            android:padding="10dp" android:layout_marginEnd="4dp"
            android:background="@drawable/widget_chip_dark" />

        <ImageView
            android:id="@+id/widget_recents_seg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="10dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_chip_dark"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="centerInside"
            android:visibility="gone" />

        <TextView android:id="@+id/widget_keypad"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:text="@string/tab_keypad" android:textSize="13sp"
            android:textStyle="bold" android:textColor="#E8EAED"
            android:padding="10dp" android:layout_marginStart="4dp"
            android:background="@drawable/widget_chip_dark" />

        <ImageView
            android:id="@+id/widget_keypad_seg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="10dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_chip_dark"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="centerInside"
            android:visibility="gone" />

    </LinearLayout>
</LinearLayout>