<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="#1E1F22">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LibreHU Dialer" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:paddingBottom="10dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <Button android:id="@+id/widget_open_dialer" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Open" android:contentDescription="Open dialer" />
        <Button android:id="@+id/widget_contacts" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Contacts" android:contentDescription="Open contacts" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <Button android:id="@+id/widget_recents" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Recent calls" android:contentDescription="Open recent calls" />
        <Button android:id="@+id/widget_keypad" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Keypad" android:contentDescription="Open dial pad" />
    </LinearLayout>
</LinearLayout>
