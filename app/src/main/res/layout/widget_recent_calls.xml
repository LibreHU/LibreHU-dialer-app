<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_recent_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="#1E1F22">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Recent calls" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_recent_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Latest calls" android:textColor="#9AA0A6" android:textSize="11sp" android:paddingTop="3dp" android:paddingBottom="8dp" />
    <TextView android:id="@+id/widget_recent_line1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E8EAED" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:paddingVertical="5dp" />
    <TextView android:id="@+id/widget_recent_line2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E8EAED" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:paddingVertical="5dp" />
    <TextView android:id="@+id/widget_recent_line3" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E8EAED" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:paddingVertical="5dp" />
    <Button android:id="@+id/widget_recent_open" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open call history" />
</LinearLayout>
